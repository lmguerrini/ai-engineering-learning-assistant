# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# LangSmith tracing (optional)
# Set LANGCHAIN_TRACING_V2=true and provide LANGCHAIN_API_KEY to enable tracing.
# Tracing is disabled by default. The app runs normally without a LangSmith account.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=ai-engineering-learning-assistant
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# App
APP_LOG_LEVEL=DEBUG
APP_DEFAULT_MODEL=gpt-4o-mini

# Knowledge Base
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHROMA_PERSIST_DIR=data/chroma
RAW_DOCUMENTS_DIR=data/raw
OFFICIAL_DOCS_DIR=data/official_docs
OFFICIAL_DOCS_COLLECTION=official_docs
